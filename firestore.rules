rules_version = '2';

// Deploy from the Firebase console (Firestore Database -> Rules) or with
// `firebase deploy --only firestore:rules` once you have firebase-tools set up.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one document holding their caught IDs.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
